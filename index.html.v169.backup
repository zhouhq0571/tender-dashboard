  '黑龙江': 1, '吉林': 2, '辽宁': 3,
  // 华北
  '内蒙古': 4, '北京': 5, '天津': 6, '河北': 7, '山西': 8,
  // 西北
  '陕西': 9, '甘肃': 10, '宁夏': 11, '青海': 12, '新疆': 13,
  // 华东
  '山东': 14, '江苏': 15, '浙江': 16, '安徽': 17, '福建': 18, '江西': 19, '上海': 20,
  // 华中
  '河南': 21, '湖北': 22, '湖南': 23,
  // 西南
  '重庆': 24, '四川': 25, '贵州': 26, '云南': 27, '西藏': 28,
  // 华南
  '广东': 29, '广西': 30, '海南': 31,
};

const REC_CLASS = {
  '🔥 ★★★ 强烈建议投标': 'rec-strong',
  '⭐ ★★☆ 建议投标': 'rec-suggest',
  '★☆☆ 可关注': 'rec-watch',
  '☆☆☆ 已截止': 'rec-none',
  '☆☆☆ 不建议': 'rec-no',
};

// 读取JSON数据
let allProjects = [];
try {
  const dataEl = document.getElementById('tender-data');
  if (dataEl) {
    allProjects = JSON.parse(dataEl.textContent).projects;
  }
} catch (e) {
  console.error('Failed to parse tender data:', e);
}

// 解析截止日期
function parseDeadline(d) {
  if (!d) return new Date('2099-12-31');
  try {
    if (d.includes(' ')) return new Date(d.replace(/-/g, '/'));
    return new Date(d.replace(/-/g, '/') + ' 23:59');
  } catch {
    return new Date('2099-12-31');
  }
}

// 排序规则：地理区域从北到南 → 省份从北到南 → 公司名（同公司连续）→ 投标建议从高到低 → 截止日期从早到晚
function sortProjects(projects) {
  return [...projects].sort((a, b) => {
    const ra = REGION_ORDER[a.region] || 99;
    const rb = REGION_ORDER[b.region] || 99;
    if (ra !== rb) return ra - rb;
    const pa = PROVINCE_ORDER[a.province] || 99;
    const pb = PROVINCE_ORDER[b.province] || 99;
    if (pa !== pb) return pa - pb;
    if (a.company !== b.company) return a.company.localeCompare(b.company);
    const recA = REC_PRIORITY[a.rec] || 99;
    const recB = REC_PRIORITY[b.rec] || 99;
    if (recA !== recB) return recA - recB;
    return parseDeadline(a.deadline) - parseDeadline(b.deadline);
  });
}

// 生成单行HTML
function renderRow(p, seq, tabPrefix) {
  const zebraClass = (seq % 2 === 0) ? ' zebra' : '';
  const recClass = REC_CLASS[p.rec] || 'rec-watch';
  const tagsHtml = p.tags.map(t => 
    `<span class="biz-tag" data-tag="${t}" onclick="filterByTag('${t}')">${t}</span>`
  ).join(' ');
  const budgetDisplay = p.budget || '';
  
  return `<tr class="${zebraClass}" data-company="${p.company}" data-method="${p.method}" data-project="${p.project}" data-tags="${p.tags.join(',')}" data-province="${p.province}" data-rec="${p.rec}" id="${tabPrefix}-row-${seq}">
    <td class="col-seq">${seq}</td>
    <td class="col-region"><span class="region-badge">${p.region}</span></td>
    <td class="col-province">${p.province}</td>
    <td class="col-company"><strong>${p.company}</strong></td>
    <td class="col-project">${p.project}</td>
    <td class="col-overview" title="${p.overview}">${p.overview}</td>
    <td class="col-budget">${budgetDisplay}</td>
    <td class="col-deadline">${p.deadline}</td>
    <td class="col-method"><span class="method-badge">${p.method}</span></td>
    <td class="col-contact">${p.contact}</td>
    <td class="col-tags">${tagsHtml}</td>
    <td class="col-rec"><span class="${recClass}">${p.rec}</span></td>
    <td class="col-url"><a href="${p.url}" target="_blank" class="url-link-colored" title="${p.source}">${p.source}</a></td>
  </tr>`;
}

// 渲染指定tab的tbody
function renderTabBody(tbodyId, projects, tabPrefix) {
  const tbody = document.getElementById(tbodyId);
  if (!tbody) return;
  const sorted = sortProjects(projects);
  tbody.innerHTML = sorted.map((p, i) => renderRow(p, i + 1, tabPrefix)).join('');
  return sorted.length;
}

// 更新统计数字（核心函数：所有数字从此处统一计算）
function updateStats() {
  // 按推荐等级分类
  const strong = allProjects.filter(p => p.rec === '🔥 ★★★ 强烈建议投标');
  const suggest = allProjects.filter(p => p.rec === '⭐ ★★☆ 建议投标');
  const trust = allProjects.filter(p => {
    const c = p.company;
    return (c.includes('信托') && !c.includes('银行')) || c === '中信登';
  });
  const bank = allProjects.filter(p => !trust.includes(p));
  
  const total = allProjects.length;
  const bankCount = bank.length;
  const trustCount = trust.length;
  const strongCount = strong.length;
  const suggestCount = suggest.length;
  
  // 更新封面统计卡片
  document.getElementById('stat-all').textContent = total;
  document.getElementById('stat-bank').textContent = bankCount;
  document.getElementById('stat-trust').textContent = trustCount;
  document.getElementById('stat-strong').textContent = strongCount;
  document.getElementById('stat-suggest').textContent = suggestCount;
  
  // 更新Tab标题
  document.getElementById('tab-title-all').textContent = `全部有效招标 (${total})`;
  document.getElementById('tab-title-bank').textContent = `银行行业 (${bankCount})`;
  document.getElementById('tab-title-trust').textContent = `信托行业 (${trustCount})`;
  document.getElementById('tab-title-strong').textContent = `强烈建议投标 (${strongCount})`;
  document.getElementById('tab-title-suggest').textContent = `建议投标 (${suggestCount})`;
  
  // 更新result-count（初始值，筛选后会重新计算）
  document.getElementById('count-all').textContent = total;
  document.getElementById('count-bank').textContent = bankCount;
  document.getElementById('count-trust').textContent = trustCount;
  document.getElementById('count-strong').textContent = strongCount;
  document.getElementById('count-suggest').textContent = suggestCount;
  
  // 渲染各tab tbody
  renderTabBody('tbody-all', allProjects, 'tab-all');
  renderTabBody('tbody-bank', bank, 'tab-bank');
  renderTabBody('tbody-trust', trust, 'tab-trust');
  renderTabBody('tbody-strong', strong, 'tab-strong');
  renderTabBody('tbody-suggest', suggest, 'tab-suggest');
  
  // 更新空状态显示
  updateEmptyState('all', total);
  updateEmptyState('bank', bankCount);
  updateEmptyState('trust', trustCount);
  updateEmptyState('strong', strongCount);
  updateEmptyState('suggest', suggestCount);
  
  // 更新封面和封底时间（从JSON数据读取，反映数据实际更新时间）
  const dataEl = document.getElementById('tender-data');
  if (dataEl) {
    try {
      const data = JSON.parse(dataEl.textContent);
      const date = data.date || '2026年06月15日';
      const timePeriod = data.timePeriod || '上午';
      const timeStr = `${date} ${timePeriod}`;
      const coverEl = document.getElementById('cover-update-time');
      if (coverEl) coverEl.textContent = `数据更新时间：${timeStr}`;
      const footerEl = document.getElementById('footer-update-time');
      if (footerEl) footerEl.textContent = timeStr;
    } catch (e) {
      // 静默失败，保持HTML中的静态时间
    }
  }

  // 填充筛选下拉框
  populateFilters();
}

function updateEmptyState(tabId, count) {
  const empty = document.getElementById('empty-' + tabId);
  if (empty) empty.classList.toggle('show', count === 0);
}

// 填充筛选下拉框选项
function populateFilters() {
  const provinces = [...new Set(allProjects.map(p => p.province))].sort();
  const methods = [...new Set(allProjects.map(p => p.method))].sort();
  const recs = [...new Set(allProjects.map(p => p.rec))].sort();
  const companies = [...new Set(allProjects.map(p => p.company))].sort();
  const sources = [...new Set(allProjects.map(p => p.source))].sort();
  
  fillSelect('filter-province', provinces);
  fillSelect('filter-method', methods);
  fillSelect('filter-rec', recs);
  fillSelect('filter-company', companies);
  fillSelect('filter-source', sources);
}

function fillSelect(id, items) {
  const sel = document.getElementById(id);
  if (!sel) return;
  const first = sel.options[0];
  sel.innerHTML = '';
  sel.appendChild(first);
  items.forEach(item => {
    const opt = document.createElement('option');
    opt.value = item;
    opt.textContent = item;
    sel.appendChild(opt);
  });
}

// ==================== Tab切换 ====================
let currentTab = 'all';
let activeTags = [];

function showTab(tabId) {
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.group-tab').forEach(t => t.classList.remove('active'));
  document.getElementById('tab-' + tabId).classList.add('active');
  event.target.classList.add('active');
  currentTab = tabId;
  applyFilters();
}

document.querySelectorAll('.group-tab').forEach(tab => {
  tab.addEventListener('click', function() {
    const text = this.textContent;
    if (text.includes('全部')) currentTab = 'all';
    else if (text.includes('银行行业')) currentTab = 'bank';
    else if (text.includes('信托')) currentTab = 'trust';
    else if (text.includes('强烈')) currentTab = 'strong';
    else if (text.includes('建议投标')) currentTab = 'suggest';
  });
});

// ==================== 筛选逻辑 ====================
function filterByTag(tag) {
  if (tag === '') {
    activeTags = [];
    document.querySelectorAll('.filter-tag-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.tag === '');
    });
  } else {
    const index = activeTags.indexOf(tag);
    if (index > -1) { activeTags.splice(index, 1); }
    else { activeTags.push(tag); }
    document.querySelectorAll('.filter-tag-btn').forEach(btn => {
      const btnTag = btn.dataset.tag;
      if (btnTag === '') { btn.classList.toggle('active', activeTags.length === 0); }
      else { btn.classList.toggle('active', activeTags.includes(btnTag)); }
    });
  }
  applyFilters();
}

function applyFilters() {
  const province = document.getElementById('filter-province').value;
  const method = document.getElementById('filter-method').value;
  const rec = document.getElementById('filter-rec').value;
  const company = document.getElementById('filter-company').value;
  const source = document.getElementById('filter-source').value;
  const search = document.getElementById('filter-search').value.toLowerCase();
  
  updateActiveFilters();
  
  // 获取当前tab的所有行
  const tabBodyId = 'tbody-' + currentTab;
  const tbody = document.getElementById(tabBodyId);
  if (!tbody) return;
  
  const rows = tbody.querySelectorAll('tr');
  let visibleCount = 0;
  
  rows.forEach(row => {
    const rProvince = row.dataset.province || '';
    const rMethod = row.dataset.method || '';
    const rRec = row.dataset.rec || '';
    const rCompany = row.dataset.company || '';
    const rTags = row.dataset.tags || '';
    const rProject = row.dataset.project || '';
    
    // 从URL链接的title属性获取source（简化处理）
    const link = row.querySelector('.url-link-colored');
    const rSource = link ? link.getAttribute('title') || '' : '';
    
    let show = true;
    if (province && rProvince !== province) show = false;
    if (method && rMethod !== method) show = false;
    if (rec && rRec !== rec) show = false;
    if (company && rCompany !== company) show = false;
    if (source && rSource !== source) show = false;
    if (search && !rProject.toLowerCase().includes(search)) show = false;
    if (activeTags.length > 0) {
      const rowTags = rTags.split(',');
      const hasTag = activeTags.some(t => rowTags.includes(t));
      if (!hasTag) show = false;
    }
    
    row.style.display = show ? '' : 'none';
    if (show) visibleCount++;
  });
  
  // 重新编号可见行
  let seq = 1;
  rows.forEach(row => {
    if (row.style.display !== 'none') {
      const seqCell = row.querySelector('.col-seq');
      if (seqCell) seqCell.textContent = seq;
      // 更新zebra类
      row.classList.toggle('zebra', seq % 2 === 0);
      seq++;
    }
  });
  
  // 更新result-count
  const countEl = document.getElementById('count-' + currentTab);
  if (countEl) {
    countEl.textContent = visibleCount;
    countEl.classList.add('changed');
    setTimeout(() => countEl.classList.remove('changed'), 300);
  }
  
  // 更新空状态
  updateEmptyState(currentTab, visibleCount);
}

function updateActiveFilters() {
  const province = document.getElementById('filter-province').value;
  const method = document.getElementById('filter-method').value;
  const rec = document.getElementById('filter-rec').value;
  const company = document.getElementById('filter-company').value;
  const source = document.getElementById('filter-source').value;
  const search = document.getElementById('filter-search').value;
  const container = document.getElementById('active-filters-container');
  const panel = document.getElementById('active-filters');
  let html = ''; let hasFilter = false;
  if (province) { html += `<span class="filter-chip" onclick="clearFilter('province')">省份: ${province} <span class="remove">×</span></span>`; hasFilter = true; }
  if (method) { html += `<span class="filter-chip" onclick="clearFilter('method')">方式: ${method} <span class="remove">×</span></span>`; hasFilter = true; }
  if (rec) { html += `<span class="filter-chip" onclick="clearFilter('rec')">建议: ${rec} <span class="remove">×</span></span>`; hasFilter = true; }
  if (company) { html += `<span class="filter-chip" onclick="clearFilter('company')">单位: ${company} <span class="remove">×</span></span>`; hasFilter = true; }
  if (source) { html += `<span class="filter-chip" onclick="clearFilter('source')">来源: ${source} <span class="remove">×</span></span>`; hasFilter = true; }
  if (search) { html += `<span class="filter-chip" onclick="clearFilter('search')">搜索: ${search} <span class="remove">×</span></span>`; hasFilter = true; }
  if (activeTags.length > 0) {
    activeTags.forEach(tag => {
      html += `<span class="filter-chip" onclick="removeTagFilter('${tag}')">标签: ${tag} <span class="remove">×</span></span>`;
    });
    hasFilter = true;
  }
  container.innerHTML = html;
  panel.classList.toggle('show', hasFilter);
}

function clearFilter(type) {
  if (type === 'search') document.getElementById('filter-search').value = '';
  else document.getElementById('filter-' + type).value = '';
  applyFilters();
}

function removeTagFilter(tag) {
  filterByTag(tag);
}

function resetFilters() {
  document.getElementById('filter-province').value = '';
  document.getElementById('filter-method').value = '';
  document.getElementById('filter-rec').value = '';
  document.getElementById('filter-company').value = '';
  document.getElementById('filter-source').value = '';
  document.getElementById('filter-search').value = '';
  activeTags = [];
  document.querySelectorAll('.filter-tag-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.tag === '');
  });
  applyFilters();
}

// ==================== 初始化 ====================
document.addEventListener('DOMContentLoaded', function() {
  updateStats();
});

// ==================== 开发者模式 ====================
let devPanelOpen = false;
let devFiles = [];
let devUrls = [];

// 方案A: 在页面任意位置输入 "dev" 序列触发（Konami Code风格）
let keySequence = [];
const DEV_CODE = ['d','e','v'];
document.addEventListener('keydown', function(e) {
  const key = e.key.toLowerCase();
  keySequence.push(key);
  if (keySequence.length > 3) keySequence.shift();
  if (keySequence.join('') === 'dev') {
    keySequence = [];
    toggleDevPanel();
  }
});

// 方案B: 连按5次 ~ 键触发（备用）
let tildeCount = 0;
let tildeTimer = null;
document.addEventListener('keydown', function(e) {
  if (e.key === '~' || e.key === '`') {
    tildeCount++;
    clearTimeout(tildeTimer);
    tildeTimer = setTimeout(() => { tildeCount = 0; }, 1000);
    if (tildeCount >= 5) {
      tildeCount = 0;
      toggleDevPanel();
    }
  }
});

function toggleDevPanel() {
  const panel = document.getElementById('dev-panel');
  if (!panel) return;
  devPanelOpen = !devPanelOpen;
  panel.style.display = devPanelOpen ? 'flex' : 'none';
  if (devPanelOpen) {
    updateDevStatus();
    document.getElementById('dev-dropzone').classList.remove('dragover');
  }
}

function updateDevStatus() {
  const total = allProjects.length;
  const today = new Date().toLocaleDateString('zh-CN');
  const dataEl = document.getElementById('tender-data');
  let version = 'v24';
  if (dataEl) {
    try {
      const data = JSON.parse(dataEl.textContent);
      version = data.version || 'v24';
    } catch (e) {
      version = 'v24';
    }
  }
  document.getElementById('dev-status-text').textContent = 
    `${total}个项目 | ${today} | 当前版本: ${version}`;
}

// 文件拖放处理
function initDevDropzone() {
  const dz = document.getElementById('dev-dropzone');
  if (!dz) return;
  
  ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
    dz.addEventListener(eventName, preventDefaults, false);
  });
  
  function preventDefaults(e) {
    e.preventDefault();
    e.stopPropagation();
  }
  
  dz.addEventListener('dragenter', () => dz.classList.add('dragover'));
  dz.addEventListener('dragleave', () => dz.classList.remove('dragover'));
  
  dz.addEventListener('drop', function(e) {
    dz.classList.remove('dragover');
    const files = Array.from(e.dataTransfer.files);
    handleDevFiles(files);
  });
  
  // 点击选择文件
  dz.addEventListener('click', function() {
    const input = document.createElement('input');
    input.type = 'file';
    input.multiple = true;
    input.accept = '.xlsx,.xls,.doc,.docx,.png,.jpg,.jpeg,.gif,.bmp,.webp';
    input.onchange = function() {
      handleDevFiles(Array.from(this.files));
    };
    input.click();
  });
}

function handleDevFiles(files) {
  const allowed = ['xlsx','xls','doc','docx','png','jpg','jpeg','gif','bmp','webp'];
  const validFiles = files.filter(f => {
    const ext = f.name.split('.').pop().toLowerCase();
    return allowed.includes(ext);
  });
  
  if (validFiles.length === 0) {
    alert('不支持的文件类型。仅支持: Excel, Word, 图片');
    return;
  }
  
  // 简单记录文件名和大小
  const fileObjs = validFiles.map(f => ({
    name: f.name,
    size: f.size
  }));
  
  devFiles = devFiles.concat(fileObjs);
  renderDevFileList();
}

function renderDevFileList() {
  const list = document.getElementById('dev-file-list');
  if (!list) return;
  
  if (devFiles.length === 0) {
    list.innerHTML = '<p style="color:#999; font-size:12px;">暂无文件，请拖放或点击上方区域添加</p>';
    return;
  }
  
  list.innerHTML = devFiles.map((item, i) => {
    const icon = item.name.match(/\.(xlsx|xls)$/i) ? '📊' : 
                 item.name.match(/\.(doc|docx)$/i) ? '📝' : '🖼️';
    return `<div class="dev-file-item" style="display:flex; justify-content:space-between; align-items:center; padding:6px 10px; background:#f1f5f9; border-radius:6px; margin-bottom:4px; font-size:12px;">
      <span>${icon} ${item.name} (${(item.size/1024).toFixed(1)}KB)</span>
      <button onclick="removeDevFile(${i})" title="移除" style="background:#fee2e2; color:#dc2626; border:none; width:22px; height:22px; border-radius:50%; cursor:pointer; font-size:14px; line-height:1; padding:0;">×</button>
    </div>`;
  }).join('');
}

function removeDevFile(index) {
  devFiles.splice(index, 1);
  renderDevFileList();
}

// 添加网址
function addDevUrl() {
  const input = document.getElementById('dev-url-input');
  const url = input.value.trim();
  if (!url) return;
  if (!url.match(/^https?:\/\//i)) {
    alert('网址必须以 http:// 或 https:// 开头');
    return;
  }
  devUrls.push(url);
  input.value = '';
  renderDevUrlList();
}

function renderDevUrlList() {
  const list = document.getElementById('dev-url-list');
  if (!list) return;
  
  if (devUrls.length === 0) {
    list.innerHTML = '<p style="color:#999; font-size:12px;">暂无网址</p>';
    return;
  }
  
  list.innerHTML = devUrls.map((u, i) => 
    `<div class="dev-url-item">
      <span>🔗 ${u.substring(0, 60)}${u.length>60?'...':''}</span>
      <button onclick="removeDevUrl(${i})" title="移除">×</button>
    </div>`
  ).join('');
}

function removeDevUrl(index) {
  devUrls.splice(index, 1);
  renderDevUrlList();
}

// 生成导入指令
function generateImportCommand() {
  const textContent = document.getElementById('dev-text-input').value.trim();
  const operationType = document.getElementById('dev-operation-type')?.value || 'add';
  
  if (devFiles.length === 0 && devUrls.length === 0 && !textContent) {
    alert('请先添加文件、网址或文字内容');
    return;
  }
  
  const now = new Date().toLocaleString('zh-CN');
  let cmd = `=== 招标信息处理任务 ===\n生成时间: ${now}\n\n`;
  
  // 操作类型说明
  const opMap = {
    'add': '【操作】新增招标项目到看板',
    'remove': '【操作】删除看板中的过期/无效项目',
    'update': '【操作】修正看板中现有项目的信息',
    'full': '【操作】全量更新（删除过期 + 新增 + 重新排序）'
  };
  cmd += `${opMap[operationType] || opMap['add']}\n\n`;
  
  // 文件部分
  if (devFiles.length > 0) {
    cmd += `【待上传文件清单】(${devFiles.length}个，请逐一上传)\n`;
    devFiles.forEach((item, i) => {
      cmd += `${i+1}. ${item.name}\n`;
    });
    cmd += `\n⚠️ 重要：请先在对话中上传以上所有文件，再粘贴此指令\n\n`;
  }
  
  // 网址部分
  if (devUrls.length > 0) {
    cmd += `【待抓取网址】(${devUrls.length}个)\n`;
    devUrls.forEach((u, i) => {
      cmd += `${i+1}. ${u}\n`;
    });
    cmd += `\n`;
  }
  
  // 文字部分
  if (textContent) {
    cmd += `【补充说明】\n${textContent}\n\n`;
  }
  
  cmd += `=== 处理要求 ===\n`;
  cmd += `1. 按 tender-daily-dispatch Skill 规则处理\n`;
  cmd += `2. 提取有效招标项目（银行/信托/理财子公司，排除信贷/支付/行政/硬件等）\n`;
  cmd += `3. 删除已过期项目（截止日期早于当天）\n`;
  cmd += `4. 业务标签归类（14个标准标签）\n`;
  cmd += `5. 按完整排序规则排序：大区从北到南→省份从北到南→公司名→投标建议→截止日期\n`;
  cmd += `6. 生成新版本看板并部署到 https://hstender.cn/\n`;
  cmd += `7. 更新封面数据更新时间\n`;
  
  document.getElementById('dev-command-output').value = cmd;
}

// 复制到剪贴板
function copyDevCommand() {
  const textarea = document.getElementById('dev-command-output');
  if (!textarea.value.trim()) {
    alert('请先生成导入指令');
    return;
  }
  textarea.select();
  document.execCommand('copy');
  
  const btn = document.getElementById('dev-copy-btn');
  const original = btn.textContent;
  btn.textContent = '✅ 已复制!';
  btn.style.background = '#10b981';
  setTimeout(() => {
    btn.textContent = original;
    btn.style.background = '';
  }, 2000);
}

// 导出当前数据为JSON
function exportCurrentData() {
  const data = {
    exportTime: new Date().toISOString(),
    projectCount: allProjects.length,
    projects: allProjects
  };
  const blob = new Blob([JSON.stringify(data, null, 2)], {type: 'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `tender_data_export_${new Date().toISOString().slice(0,10)}.json`;
  a.click();
  URL.revokeObjectURL(url);
}

// 清空所有
function clearDevAll() {
  devFiles = [];
  devUrls = [];
  document.getElementById('dev-text-input').value = '';
  document.getElementById('dev-command-output').value = '';
  renderDevFileList();
  renderDevUrlList();
}

// 初始化开发者模式
document.addEventListener('DOMContentLoaded', function() {
  initDevDropzone();
});
</script>

<!-- ==================== 开发者面板 ==================== -->
<div id="dev-panel" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.6); z-index:99999; justify-content:center; align-items:center; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">
  <div style="background:#fff; width:850px; max-width:95vw; max-height:92vh; border-radius:16px; box-shadow:0 25px 80px rgba(0,0,0,0.4); display:flex; flex-direction:column; overflow:hidden;">
    
    <!-- 头部 -->
    <div style="background:linear-gradient(135deg,#0a2540 0%,#1e3a5f 100%); color:#fff; padding:18px 24px; display:flex; justify-content:space-between; align-items:center;">
      <div>
        <h2 style="margin:0; font-size:20px; font-weight:700;">🔧 开发者工具</h2>
        <p style="margin:4px 0 0; font-size:12px; opacity:0.8;">仅开发者使用 | 页面输入"dev" 或 连按5次~键</p>
      </div>
      <button onclick="toggleDevPanel()" style="background:rgba(255,255,255,0.15); border:none; color:#fff; width:36px; height:36px; border-radius:50%; cursor:pointer; font-size:18px; line-height:1;">×</button>
    </div>
    
    <!-- 状态栏 -->
    <div style="background:#f0f4f8; padding:10px 24px; font-size:13px; color:#475569; border-bottom:1px solid #e2e8f0;">
      <span id="dev-status-text">加载中...</span>
    </div>
    
    <!-- 内容区 -->
    <div style="padding:20px 24px; overflow-y:auto; flex:1;">
      
      <!-- 操作类型选择 -->
      <div style="margin-bottom:12px; padding:12px; background:#f0f9ff; border:1px solid #bae6fd; border-radius:8px;">
        <label style="display:block; font-size:13px; font-weight:600; color:#0369a1; margin-bottom:6px;">🎯 操作类型</label>
        <select id="dev-operation-type" style="width:100%; padding:10px 12px; border:1px solid #7dd3fc; border-radius:8px; font-size:13px; background:#fff; cursor:pointer;">
          <option value="add">📥 新增招标项目到看板</option>
          <option value="remove">🗑️ 删除看板中的过期/无效项目</option>
          <option value="update">✏️ 修正看板中现有项目的信息</option>
          <option value="full">🔄 全量更新（删除过期 + 新增 + 重新排序）</option>
        </select>
        <p style="margin:6px 0 0; font-size:11px; color:#0ea5e9;">💡 选择操作类型后，生成对应的标准化处理指令</p>
      </div>
      
      <!-- 文件拖放区 -->
      <div style="margin-bottom:16px;">
        <label style="display:block; font-size:13px; font-weight:600; color:#334155; margin-bottom:6px;">📁 待上传文件清单（仅记录文件名，生成指令后需在对话中上传）</label>
        <div id="dev-dropzone" style="border:2px dashed #cbd5e1; border-radius:10px; padding:28px; text-align:center; cursor:pointer; transition:all 0.2s; background:#f8fafc;">
          <div style="font-size:32px; margin-bottom:8px;">📂</div>
          <p style="margin:0; font-size:14px; color:#64748b;">拖放 Excel / Word / 图片 到这里</p>
          <p style="margin:4px 0 0; font-size:12px; color:#94a3b8;">仅用于生成文件清单，实际处理需在对话中上传文件</p>
        </div>
        <div id="dev-file-list" style="margin-top:8px; max-height:120px; overflow-y:auto;">
          <p style="color:#999; font-size:12px;">暂无文件</p>
        </div>
      </div>
      
      <!-- 网址输入 -->
      <div style="margin-bottom:16px;">
        <label style="display:block; font-size:13px; font-weight:600; color:#334155; margin-bottom:6px;">🔗 招标网址</label>
        <div style="display:flex; gap:8px;">
          <input type="text" id="dev-url-input" placeholder="https://..." style="flex:1; padding:10px 12px; border:1px solid #cbd5e1; border-radius:8px; font-size:13px;">
          <button onclick="addDevUrl()" style="padding:10px 16px; background:#0a2540; color:#fff; border:none; border-radius:8px; cursor:pointer; font-size:13px; font-weight:600;">添加</button>
        </div>
        <div id="dev-url-list" style="margin-top:8px; max-height:80px; overflow-y:auto;">
          <p style="color:#999; font-size:12px;">暂无网址</p>
        </div>
      </div>
      
      <!-- 文字粘贴 -->
      <div style="margin-bottom:16px;">
        <label style="display:block; font-size:13px; font-weight:600; color:#334155; margin-bottom:6px;">📝 文字描述 / 招标信息</label>
        <textarea id="dev-text-input" placeholder="粘贴招标公告文字、项目描述、或任何需要处理的文字内容..." style="width:100%; height:100px; padding:10px 12px; border:1px solid #cbd5e1; border-radius:8px; font-size:13px; resize:vertical; box-sizing:border-box;"></textarea>
      </div>
      
      <!-- 操作按钮 -->
      <div style="display:flex; gap:10px; margin-bottom:16px;">
        <button onclick="generateImportCommand()" style="flex:1; padding:12px; background:linear-gradient(135deg,#0a2540,#1e3a5f); color:#fff; border:none; border-radius:8px; cursor:pointer; font-size:14px; font-weight:700;">🚀 生成导入指令</button>
        <button onclick="exportCurrentData()" style="padding:12px 16px; background:#f1f5f9; color:#334155; border:1px solid #cbd5e1; border-radius:8px; cursor:pointer; font-size:13px; font-weight:600;">📥 导出当前JSON</button>
        <button onclick="clearDevAll()" style="padding:12px 16px; background:#fee2e2; color:#dc2626; border:1px solid #fecaca; border-radius:8px; cursor:pointer; font-size:13px; font-weight:600;">🗑️ 清空</button>
      </div>
      
      <!-- 输出区 -->
      <div>
        <label style="display:block; font-size:13px; font-weight:600; color:#334155; margin-bottom:6px;">📋 生成的指令（复制后，在对话中上传文件并粘贴此指令）</label>
        <textarea id="dev-command-output" readonly placeholder="点击"生成导入指令"后，这里会显示标准化的处理请求..." style="width:100%; height:180px; padding:10px 12px; border:1px solid #cbd5e1; border-radius:8px; font-size:12px; font-family:'SF Mono', Monaco, monospace; background:#f8fafc; resize:vertical; box-sizing:border-box;"></textarea>
        <div style="text-align:right; margin-top:8px;">
          <button id="dev-copy-btn" onclick="copyDevCommand()" style="padding:10px 20px; background:#0a2540; color:#fff; border:none; border-radius:8px; cursor:pointer; font-size:13px; font-weight:600;">📋 复制到剪贴板</button>
        </div>
      </div>
      
    </div>
  </div>
</div>

<style>
#dev-dropzone.dragover {
  border-color: #0a2540 !important;
  background: #e0e7ff !important;
  transform: scale(1.01);
}
.dev-file-item, .dev-url-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 10px;
  background: #f1f5f9;
  border-radius: 6px;
  margin-bottom: 4px;
  font-size: 12px;
}
.dev-file-item button, .dev-url-item button {
  background: #fee2e2;
  color: #dc2626;
  border: none;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  cursor: pointer;
  font-size: 14px;
  line-height: 1;
  padding: 0;
}
.dev-file-item button:hover, .dev-url-item button:hover {
  background: #dc2626;
  color: #fff;
}
</style>

</body>
</html>

