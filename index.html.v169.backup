<meta property="og:title" content="恒生银信招标资讯速递"/>
<meta property="og:description" content="适合恒生银信LBO关注和参与的银行及理财子公司、信托公司近期公开发布的最新有效招标资讯信息/每日看板，可供行业销售/解决方案/产品售前人员日常工作参考了解。"/>
<meta property="og:type" content="website"/>
<meta property="og:url" content="https://hstender.cn/"/>
<meta property="og:image" content="https://hstender.cn/og-image.png"/>
<meta property="og:locale" content="zh_CN"/>
<style>
:root { --primary: #0f2a4a; --primary-light: #1e4a7a; --primary-soft: #e8f0f8; --accent: #c41e3a; --accent-light: #e85d75; --accent-soft: #fef2f2; --gold: #b8860b; --gold-light: #d4a843; --gold-soft: #fffbeb; --bg: #f5f7fa; --card: #ffffff; --text: #1a202c; --text-light: #64748b; --text-muted: #94a3b8; --border: #e2e8f0; --border-light: #f1f5f9; --shadow: 0 4px 16px rgba(15, 42, 74, 0.08); --shadow-lg: 0 8px 30px rgba(15, 42, 74, 0.12); --radius: 10px; --radius-sm: 6px; }
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;background:var(--bg);color:var(--text);line-height:1.6;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
.cover{background:linear-gradient(145deg,#0a2540 0%,#1e3a5f 50%,#2c5282 100%);min-height:360px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;color:white;padding:40px 40px 56px;position:relative;overflow:hidden}
.cover::before{content:"";position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(circle,rgba(255,255,255,0.03) 1px,transparent 1px);background-size:40px 40px;opacity:0.5}
.cover-content{position:relative;z-index:2;max-width:800px}
.cover-brand{position:relative;z-index:2;display:flex;align-items:center;gap:14px;margin-bottom:24px;justify-content:center}
.cover-brand div:first-child{font-size:56px !important;margin-bottom:0 !important;filter:drop-shadow(0 4px 16px rgba(212,168,67,0.4));animation:logoFloat 4s ease-in-out infinite}
@keyframes logoFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
.cover h1{font-size:42px;font-weight:900;margin-bottom:16px;letter-spacing:2px;line-height:1.2;text-shadow:0 2px 20px rgba(0,0,0,0.3);background:linear-gradient(135deg,#ffffff 0%,#f0e6d3 50%,#d4a843 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;position:relative;display:inline-block}
.cover h1::after{content:"";position:absolute;bottom:-8px;left:50%;transform:translateX(-50%);width:80px;height:3px;background:linear-gradient(90deg,transparent,var(--gold),transparent);border-radius:2px}
.cover-subtitle{font-size:16px;opacity:0.9;margin-bottom:8px;font-weight:500;letter-spacing:3px;color:#e8d5b7}
.cover-meta{font-size:14px;opacity:0.75;margin-bottom:10px;font-weight:400;letter-spacing:1px}
.cover-author{font-size:14px;margin-top:24px;padding:12px 28px;background:rgba(255,255,255,0.1);border-radius:8px;border-left:3px solid var(--gold);display:inline-block;backdrop-filter:blur(10px);letter-spacing:1px}
.cover-disclaimer{font-size:11px;opacity:0.5;margin-top:16px;letter-spacing:0.5px;max-width:600px;margin-left:auto;margin-right:auto;line-height:1.6}
.stats-bar{display:flex;justify-content:center;gap:14px;padding:24px 20px;flex-wrap:wrap;max-width:1400px;margin:0 auto}
.stat-card{background:var(--card);border-radius:var(--radius);padding:20px 28px;text-align:center;box-shadow:var(--shadow);min-width:150px;transition:all 0.3s;cursor:pointer;position:relative;overflow:hidden;border-top:3px solid transparent}
.stat-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);border-top-color:var(--primary-light)}
.stat-card .number{font-size:32px;font-weight:700;color:var(--primary-light);margin-bottom:4px;transition:color 0.3s}
.stat-card:hover .number{color:var(--primary)}
.stat-card .label{font-size:12px;color:var(--text-light);font-weight:500}
.stat-card.strong{border-top-color:var(--accent)}
.stat-card.strong .number{color:var(--accent)}
.stat-card.suggest{border-top-color:var(--gold)}
.stat-card.suggest .number{color:var(--gold)}
.filter-panel{background:var(--card);border-radius:var(--radius);padding:24px 24px 20px;margin:0 20px 16px;box-shadow:var(--shadow);max-width:1400px;margin-left:auto;margin-right:auto;border:1px solid var(--border-light)}
.filter-panel h3{font-size:13px;color:var(--text-light);margin-bottom:10px;font-weight:500;display:flex;align-items:center;gap:6px}
.filter-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px;align-items:center}
.filter-row select{padding:7px 12px;border:1px solid var(--border);border-radius:var(--radius-sm);font-size:12px;background:white;min-width:130px;cursor:pointer;outline:none;transition:all 0.2s;color:var(--text)}
.filter-row select:focus{border-color:var(--primary-light);box-shadow:0 0 0 3px var(--primary-soft)}
.filter-row input{padding:7px 12px;border:1px solid var(--border);border-radius:var(--radius-sm);font-size:12px;min-width:180px;outline:none;transition:all 0.2s}
.filter-row input:focus{border-color:var(--primary-light);box-shadow:0 0 0 3px var(--primary-soft)}
.reset-btn{padding:7px 16px;background:var(--border-light);color:var(--text-light);border:none;border-radius:var(--radius-sm);font-size:12px;cursor:pointer;transition:all 0.2s;font-weight:500}
.reset-btn:hover{background:var(--border);color:var(--text)}
.active-filters{display:none;gap:8px;flex-wrap:wrap;margin-bottom:12px;align-items:center}
.active-filters.show{display:flex}
.active-filters-label{font-size:12px;color:var(--text-muted);font-weight:500}
.filter-chip{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;background:var(--primary-soft);color:var(--primary-light);border-radius:20px;font-size:11px;font-weight:500;cursor:pointer;transition:all 0.2s}
.filter-chip:hover{background:var(--primary-light);color:white}
.filter-chip .remove{font-size:14px;line-height:1}
.biz-tag-filter{display:flex;gap:6px;flex-wrap:wrap}
.filter-tag-btn{padding:5px 12px;border:1px solid var(--border);border-radius:20px;background:white;font-size:11px;cursor:pointer;transition:all 0.2s;color:var(--text-light);font-weight:500}
.filter-tag-btn:hover{background:var(--primary-soft);color:var(--primary);border-color:var(--primary-light)}
.filter-tag-btn.active{background:var(--primary);color:white;border-color:var(--primary);box-shadow:0 2px 8px rgba(15,42,74,0.2)}
.container{max-width:1400px;margin:0 auto;padding:0 20px 40px}
.section{background:var(--card);border-radius:var(--radius);margin-bottom:20px;box-shadow:var(--shadow);overflow:hidden}
.group-tabs{display:flex;gap:0;border-bottom:1px solid var(--border);background:#f8fafc;overflow-x:auto}
.group-tab{padding:12px 24px;cursor:pointer;border-bottom:3px solid transparent;font-weight:500;font-size:13px;color:var(--text-light);transition:all 0.2s;white-space:nowrap;flex-shrink:0}
.group-tab.active{border-bottom-color:var(--primary);color:var(--primary);background:white}
.group-tab:hover{color:var(--primary);background:rgba(15,42,74,0.03)}
.tab-content{display:none;padding:0;animation:fadeIn 0.3s ease}
.tab-content.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.table-wrap{overflow:auto;padding:0;background:var(--card);max-height:620px}
table{width:100%;border-collapse:separate;border-spacing:0;font-size:13px;min-width:1210px;table-layout:fixed}
th{background:#f8fafc;padding:12px 10px;text-align:center;font-weight:600;color:var(--primary);border-bottom:2px solid var(--primary-light);white-space:nowrap;font-size:12px;position:sticky;top:0;z-index:10;letter-spacing:0.5px;text-transform:uppercase;box-shadow:0 2px 4px rgba(15,42,74,0.06)}
td{padding:14px 10px;border-bottom:1px solid var(--border-light);vertical-align:middle;text-align:center;font-size:12.5px;transition:background 0.2s ease}
tr.zebra td{background:#fafbfc}
tr:hover td{background:var(--primary-soft)}
tr{position:relative;transition:all 0.2s ease}
tr::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:transparent;transition:background 0.2s}
tr:hover::before{background:var(--primary-light)}
.col-seq{width:36px;min-width:36px;color:var(--text-muted);font-weight:500}
.col-region{width:48px;min-width:48px}
.col-province{width:56px;min-width:56px;font-weight:500}
.col-company{width:110px;min-width:110px}
.col-project{width:150px;min-width:150px;font-weight:500;color:var(--primary)}
.col-overview{width:260px;min-width:260px;color:var(--text-light);line-height:1.5}
.col-budget{width:100px;min-width:100px;font-family:"SF Mono",Monaco,monospace;font-weight:600;color:var(--primary)}
.col-deadline{width:100px;min-width:100px;font-weight:500}
.col-method{width:90px;min-width:90px}
.col-contact{width:185px;min-width:185px;font-size:11px;color:var(--text-light);line-height:1.4;word-wrap:break-word}
.col-tags{width:130px;min-width:130px}
.col-rec{width:120px;min-width:120px}
.col-url{width:110px;min-width:110px}
td.col-project,td.col-overview,td.col-contact,td.col-tags{text-align:left !important}
td.col-company{text-align:center !important}
th.col-seq,td.col-seq{position:sticky;left:0;z-index:11;background:inherit}
th.col-region,td.col-region{position:sticky;left:36px;z-index:11;background:inherit}
th.col-province,td.col-province{position:sticky;left:84px;z-index:11;background:inherit}
th.col-company,td.col-company{position:sticky;left:140px;z-index:11;background:inherit}
th.col-project,td.col-project{position:sticky;left:250px;z-index:11;background:inherit}
th.col-seq,th.col-region,th.col-province,th.col-company,th.col-project{z-index:15;background:#f8fafc}
td.col-seq,td.col-region,td.col-province,td.col-company,td.col-project{background:var(--card)}
tr.zebra td.col-seq,tr.zebra td.col-region,tr.zebra td.col-province,tr.zebra td.col-company,tr.zebra td.col-project{background:#fafbfc}
tr:hover td.col-seq,tr:hover td.col-region,tr:hover td.col-province,tr:hover td.col-company,tr:hover td.col-project{background:var(--primary-soft)}
th.col-project,td.col-project{border-right:2px solid var(--primary-light)}
.region-badge{display:inline-block;padding:3px 8px;border-radius:4px;font-size:10px;font-weight:600;background:var(--primary-soft);color:var(--primary);letter-spacing:0.5px}
.method-badge{display:inline-block;padding:3px 8px;border-radius:4px;font-size:10px;font-weight:500;background:#f1f5f9;color:var(--text-light);border:1px solid var(--border)}
.biz-tag{display:inline-block;padding:3px 10px;border-radius:12px;font-size:11px;margin:2px;cursor:pointer;transition:all 0.2s;background:#ebf8ff;color:#2b6cb0;border:1px solid #bee3f8;white-space:nowrap}
.biz-tag:hover{background:#2b6cb0;color:white;transform:scale(1.05);box-shadow:0 2px 6px rgba(43,108,176,0.3)}
.rec-strong{color:var(--accent);font-weight:700;background:var(--accent-soft);padding:4px 10px;border-radius:6px;display:inline-block;border:1px solid rgba(196,30,58,0.15);font-size:11.5px;border-left:3px solid var(--accent)}
.rec-suggest{color:var(--gold);font-weight:700;background:var(--gold-soft);padding:4px 10px;border-radius:6px;display:inline-block;border:1px solid rgba(184,134,11,0.15);font-size:11.5px;border-left:3px solid var(--gold)}
.rec-watch{color:var(--text-light);font-weight:500;background:#f7fafc;padding:4px 10px;border-radius:6px;display:inline-block;font-size:11.5px}
.rec-no{color:var(--text-muted);font-weight:500;background:#f7fafc;padding:4px 10px;border-radius:6px;display:inline-block;font-size:11.5px;opacity:0.7}
.rec-none{color:var(--text-muted);font-weight:500;background:#f0f0f0;padding:4px 10px;border-radius:6px;display:inline-block;font-size:11.5px;opacity:0.6;text-decoration:line-through}
.url-link-colored{color:var(--primary-light);text-decoration:none;font-size:11px;font-weight:500;transition:all 0.2s;display:inline-block;padding:3px 8px;background:var(--primary-soft);border-radius:4px;line-height:1.4}
.url-link-colored:hover{background:var(--primary-light);color:white}
.result-count{padding:14px 20px;font-size:13px;color:var(--text-light);border-bottom:1px solid var(--border);background:#fafbfc;display:flex;align-items:center;gap:8px;font-weight:500}
.result-count span{font-weight:700;color:var(--primary);font-size:15px;transition:all 0.3s}
.result-count span.changed{color:var(--accent);transform:scale(1.2)}
.empty-state{display:none;padding:60px 20px;text-align:center;color:var(--text-muted)}
.empty-state.show{display:block}
.empty-state-icon{font-size:48px;margin-bottom:16px;opacity:0.4}
.empty-state-text{font-size:15px;margin-bottom:8px}
.empty-state-hint{font-size:13px;opacity:0.7}
.footer-section{background:linear-gradient(145deg,#0a2540 0%,#1e3a5f 50%,#2c5282 100%);color:white;padding:50px 40px;text-align:center;margin-top:30px;position:relative;overflow:hidden}
.footer-section::before{content:"";position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(circle,rgba(255,255,255,0.02) 1px,transparent 1px);background-size:40px 40px;opacity:0.5}
.footer-content{position:relative;z-index:2;max-width:800px;margin:0 auto}
.footer-brand{display:flex;align-items:center;gap:12px;justify-content:center;margin-bottom:20px}
.footer-section h2{font-size:28px;margin-bottom:12px;font-weight:700;letter-spacing:1px}
.footer-section p{font-size:13px;opacity:0.8;line-height:2}
.footer-disclaimer{font-size:11px;opacity:0.5;margin-top:24px;padding-top:20px;border-top:1px solid rgba(255,255,255,0.15);max-width:700px;margin-left:auto;margin-right:auto;line-height:1.8}
@media(max-width:1024px){.cover h1{font-size:30px}.stats-bar{gap:10px}.stat-card{min-width:130px;padding:16px 20px}.filter-row{flex-wrap:wrap}}
@media(max-width:768px){.cover{min-height:280px;padding:30px 20px 40px}.cover h1{font-size:26px}.stats-bar{gap:8px}.stat-card{min-width:100px;padding:14px 16px}.stat-card .number{font-size:24px}.filter-panel{padding:16px}.filter-row{flex-direction:column;align-items:stretch;gap:8px}.filter-row select,.filter-row input{width:100%}.group-tab{padding:10px 14px;font-size:12px}th,td{padding:8px 6px;font-size:11px}.col-overview{max-width:200px}th.col-seq,td.col-seq,th.col-region,td.col-region,th.col-province,td.col-province,th.col-company,td.col-company,th.col-project,td.col-project{position:static;left:auto;z-index:auto}th.col-project,td.col-project{border-right:none}}
@media(max-width:480px){.cover h1{font-size:20px}.cover-subtitle{font-size:13px}.biz-tag-filter{overflow-x:auto;flex-wrap:nowrap;padding-bottom:4px}.filter-tag-btn{flex-shrink:0}.table-wrap{max-height:500px}}
</style>
</head>
<body>
<div class="cover">
<div class="cover-content">
<div class="cover-brand">
<div style="font-size:48px;margin-bottom:8px">🏦</div>
</div>
<h1>恒生银信招标资讯每日速递</h1>
<div class="cover-subtitle">银行信托事业群&nbsp;&nbsp;销售代表/解决方案&amp;售前人员专用</div>
<div class="cover-meta" id="cover-update-time">数据更新时间：2026年08月22日 中午</div>
<div class="cover-author">编制单位：恒生电子银信解决方案部</div>
<div class="cover-disclaimer">免责声明：本看板数据由AI辅助生成，仅供内部参考，具体以招标单位官方文件为准。</div>
</div>
</div>
<div class="stats-bar">
<div class="stat-card" onclick="showTab('all')"><div class="number" id="stat-all">0</div><div class="label">有效招标总数</div></div>
<div class="stat-card" onclick="showTab('bank')"><div class="number" id="stat-bank">0</div><div class="label">银行行业</div></div>
<div class="stat-card" onclick="showTab('trust')"><div class="number" id="stat-trust">0</div><div class="label">信托行业</div></div>
<div class="stat-card strong" onclick="showTab('strong')"><div class="number" id="stat-strong">0</div><div class="label">强烈建议投标</div></div>
<div class="stat-card suggest" onclick="showTab('suggest')"><div class="number" id="stat-suggest">0</div><div class="label">建议投标</div></div>
</div>
<div class="filter-panel">
<div class="filter-row">
<select id="filter-province" onchange="applyFilters()"><option value="">全部省份</option></select>
<select id="filter-method" onchange="applyFilters()"><option value="">全部招标方式</option></select>
<select id="filter-rec" onchange="applyFilters()"><option value="">全部投标建议</option></select>
<select id="filter-company" onchange="applyFilters()"><option value="">全部招标单位</option></select>
<select id="filter-source" onchange="applyFilters()"><option value="">全部信息来源</option></select>
<input id="filter-search" oninput="applyFilters()" placeholder="🔍 搜索项目名称..." type="text"/>
<button class="reset-btn" onclick="resetFilters()">↺ 重置筛选</button>
</div>
<div class="active-filters" id="active-filters">
<span class="active-filters-label">已选条件：</span>
<span id="active-filters-container"></span>
</div>
<h3>💡 点击业务标签快速筛选（支持组合筛选）：</h3>
<div class="biz-tag-filter">
<button class="filter-tag-btn active" data-tag="" onclick="filterByTag('')">全部</button>
<button class="filter-tag-btn" data-tag="财富管理" onclick="filterByTag('财富管理')">财富管理</button>
<button class="filter-tag-btn" data-tag="资产管理" onclick="filterByTag('资产管理')">资产管理</button>
<button class="filter-tag-btn" data-tag="资产托管" onclick="filterByTag('资产托管')">资产托管</button>
<button class="filter-tag-btn" data-tag="金融市场/资金/同业" onclick="filterByTag('金融市场/资金/同业')">金融市场/资金/同业</button>
<button class="filter-tag-btn" data-tag="资产服务信托" onclick="filterByTag('资产服务信托')">资产服务信托</button>
<button class="filter-tag-btn" data-tag="风控合规" onclick="filterByTag('风控合规')">风控合规</button>
<button class="filter-tag-btn" data-tag="信创/国产化" onclick="filterByTag('信创/国产化')">信创/国产化</button>
<button class="filter-tag-btn" data-tag="大模型应用" onclick="filterByTag('大模型应用')">大模型应用</button>
<button class="filter-tag-btn" data-tag="渠道系统" onclick="filterByTag('渠道系统')">渠道系统</button>
<button class="filter-tag-btn" data-tag="数据平台" onclick="filterByTag('数据平台')">数据平台</button>
<button class="filter-tag-btn" data-tag="数据服务" onclick="filterByTag('数据服务')">数据服务</button>
<button class="filter-tag-btn" data-tag="运维服务" onclick="filterByTag('运维服务')">运维服务</button>
<button class="filter-tag-btn" data-tag="人力外包" onclick="filterByTag('人力外包')">人力外包</button>
<button class="filter-tag-btn" data-tag="其他" onclick="filterByTag('其他')">其他</button>
</div>
</div>
<div class="container">
<div class="section">
<div class="group-tabs">
<div class="group-tab active" onclick="showTab('all')" id="tab-title-all">全部有效招标 (0)</div>
<div class="group-tab" onclick="showTab('bank')" id="tab-title-bank">银行行业 (0)</div>
<div class="group-tab" onclick="showTab('trust')" id="tab-title-trust">信托行业 (0)</div>
<div class="group-tab" onclick="showTab('strong')" id="tab-title-strong">强烈建议投标 (0)</div>
<div class="group-tab" onclick="showTab('suggest')" id="tab-title-suggest">建议投标 (0)</div>
</div>
<div class="tab-content active" id="tab-all">
<div class="result-count">显示 <span id="count-all">0</span> 条记录</div>
<div class="empty-state" id="empty-all">
<div class="empty-state-icon">🔍</div>
<div class="empty-state-text">未找到符合条件的招标信息</div>
